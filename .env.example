# ---- Required for real wallet / auth (add these in Vercel > Project > Settings > Environment Variables) ----

# Neon / any Postgres connection string (get a free DB at https://neon.tech)
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# Secret used to sign login session cookies. Generate one with:  openssl rand -base64 32
AUTH_SECRET="change-me-to-a-long-random-string"

# Email of the first admin. The account that registers with this email becomes admin automatically.
ADMIN_EMAIL="you@example.com"

# ---- Deriv live price feed (public data, no account needed) ----
# Deriv gives 1089 as a shared test app_id. For production register your own at
# https://api.deriv.com and put its id here.
NEXT_PUBLIC_DERIV_APP_ID="1089"
